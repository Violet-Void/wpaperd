# Maintainer: Violet-Void <https://github.com/Violet-Void>
# Based on the Arch Linux extra/wpaperd PKGBUILD by Robin Candau <antiz@archlinux.org>.
# Built with --all-features, which links libdav1d, so dav1d is a hard dependency here.
#
# Builds the Violet-Void fork and replaces the repo `wpaperd` package through
# provides/conflicts. `make arch-pkg` sets WPAPERD_SOURCE to the local checkout's HEAD;
# without it the package builds the reviewed fork commit pinned in _commit from GitHub.
# Move _commit only through a reviewed PR (see README, "Updating and rolling back").

pkgname=wpaperd-violet-git
_name=wpaperd
# Reviewed main with the config-reload (#12) and pool-adoption (#13) fixes.
_commit=c39722517e98f1f5c8a837ab14487abd9f52ee84
pkgver=1.3.0
pkgrel=1
pkgdesc="Modern wallpaper daemon for Wayland (Violet-Void fork with motion scenes)"
url="https://github.com/Violet-Void/wpaperd"
arch=('x86_64')
license=('GPL-3.0-or-later')
depends=('dav1d' 'jemalloc' 'libxkbcommon' 'mesa' 'wayland')
makedepends=('cargo' 'scdoc' 'git')
provides=("${_name}")
conflicts=("${_name}")
source=("${_name}::${WPAPERD_SOURCE:-git+${url}.git#commit=${_commit}}")
sha256sums=('SKIP')

pkgver() {
	cd "${_name}"
	git describe --long --tags --abbrev=7 | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
	cd "${_name}"
	cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
	cd "${_name}"
	export JEMALLOC_OVERRIDE=/usr/lib/libjemalloc.so
	export CARGO_FEATURE_UNPREFIXED_MALLOC_ON_SUPPORTED_PLATFORMS=1
	cargo build --frozen --release --all-features
	scdoc < man/wpaperd-output.5.scd > man/wpaperd-output.5
}

check() {
	cd "${_name}"
	export JEMALLOC_OVERRIDE=/usr/lib/libjemalloc.so
	export CARGO_FEATURE_UNPREFIXED_MALLOC_ON_SUPPORTED_PLATFORMS=1
	cargo test --frozen --all-features
}

package() {
	cd "${_name}"
	install -Dm755 target/release/wpaperd "${pkgdir}/usr/bin/wpaperd"
	install -Dm755 target/release/wpaperctl "${pkgdir}/usr/bin/wpaperctl"

	local bin
	for bin in wpaperd wpaperctl; do
		install -Dm644 "target/release/completions/${bin}.bash" \
			"${pkgdir}/usr/share/bash-completion/completions/${bin}"
		install -Dm644 "target/release/completions/_${bin}" \
			"${pkgdir}/usr/share/zsh/site-functions/_${bin}"
		install -Dm644 "target/release/completions/${bin}.fish" \
			"${pkgdir}/usr/share/fish/vendor_completions.d/${bin}.fish"
		install -Dm644 "target/release/man/${bin}.1" "${pkgdir}/usr/share/man/man1/${bin}.1"
	done
	install -Dm644 man/wpaperd-output.5 "${pkgdir}/usr/share/man/man5/wpaperd-output.5"

	install -Dm644 contrib/wpaperd.service "${pkgdir}/usr/lib/systemd/user/wpaperd.service"
	install -Dm644 README.md "${pkgdir}/usr/share/doc/${_name}/README.md"
	install -Dm644 docs/motion-scenes.md "${pkgdir}/usr/share/doc/${_name}/motion-scenes.md"
}
